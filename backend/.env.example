# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# ==========================================
# SECURITY SETTINGS
# ==========================================

# JWT Configuration
# CRITICAL: Generate a unique secret before running!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_ME_WITH_GENERATED_SECRET
JWT_EXPIRES_IN=7d

# CORS - Frontend URL (required in production)
# In production, set this to your actual frontend domain
FRONTEND_URL=http://localhost:5173

# Rate Limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX=5

# Security Features (production defaults)
# ENABLE_SECURITY_HEADERS=true
# ENABLE_RATE_LIMITING=true
# ENABLE_XSS_PROTECTION=true
