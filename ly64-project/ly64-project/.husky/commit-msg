# Проверка формата сообщения коммита
# Формат: type(scope): subject
# Пример: feat(auth): add login validation

commit_msg=$(cat "$1")

# Проверка минимальной длины
if [ ${#commit_msg} -lt 10 ]; then
  echo "❌ Сообщение коммита слишком короткое (минимум 10 символов)"
  echo "💡 Формат: type(scope): subject"
  echo "   Примеры типов: feat, fix, docs, style, refactor, test, chore"
  exit 1
fi

# Проверка на WIP коммиты
if echo "$commit_msg" | grep -qiE "^(wip|todo|fixme|temp)"; then
  echo "⚠️  Предупреждение: Обнаружен WIP/TODO/FIXME/TEMP коммит"
  echo "   Убедитесь, что это намеренно"
fi
